# ──────────────────────────────────────────────────────────────────────────────
# MinTech Ethiopia System — Environment Variables
# Copy this file to .env.local for local dev, and add every variable below
# to Vercel → Project → Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (free M0 tier works).
# Atlas → Database → Connect → Drivers → copy the URI and put your password in.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mintech?retryWrites=true&w=majority"

# OpenAI API key (used for: morning-brief narrative, photo fraud checks with
# gpt-4o-mini, Telegram ingestion bot, and the company chatbot).
OPENAI_API_KEY="sk-..."

# Telegram bot token from @BotFather (create a bot with /newbot).
TELEGRAM_BOT_TOKEN="123456789:AA..."

# Telegram chat id of Mr. Anteneh (the CEO) — the morning brief is sent here.
# Get it by messaging the bot, then visiting:
#   https://api.telegram.org/bot<TOKEN>/getUpdates  → message.chat.id
TELEGRAM_CEO_CHAT_ID="123456789"

# A random secret you invent. It is appended to the webhook URL so only
# Telegram can call it. Any long random string is fine.
TELEGRAM_WEBHOOK_SECRET="change-me-long-random-string"

# Secret used by Vercel Cron to authenticate the daily-brief job.
# Vercel automatically sends "Authorization: Bearer <CRON_SECRET>" when this
# env var exists on the project. Use any long random string.
CRON_SECRET="change-me-another-long-random-string"

# Web Push (PWA notifications) VAPID keys. Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:it@mintechethiopia.com"
# Must equal VAPID_PUBLIC_KEY (exposed to the browser for subscription).
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."

# Single shared password protecting the internal dashboard (login page).
ADMIN_PASSWORD="change-me-strong-password"

# Public URL of the deployed app (no trailing slash). Used in Telegram
# buttons, push notification links and the PDF register footer.
APP_URL="https://your-project.vercel.app"
