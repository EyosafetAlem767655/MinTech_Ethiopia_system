# MinTech Ethiopia System - Environment Variables
# Copy this file to .env.local for local development.
# Add the same variables to Vercel Project Settings -> Environment Variables
# for Production and Preview, then redeploy.

# MongoDB Atlas connection string.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mintech?retryWrites=true&w=majority"

# OpenAI API key. Used by dashboard chat, Telegram document/photo reading,
# damaged-bag checks, stone scoring and morning brief narrative writing.
OPENAI_API_KEY="sk-..."

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN="123456789:AA..."

# Telegram chat id of the CEO/owner. Used for morning briefs and purchase approvals.
TELEGRAM_CEO_CHAT_ID="123456789"

# Optional comma-separated Telegram chat ids for the 8:00 AM EAT report reminder.
# Employees who have used the bot are also included automatically.
TELEGRAM_REMINDER_CHAT_IDS="123456789,987654321"

# Random webhook secret. The webhook setup script sends this both as a Telegram
# secret token and as a URL query fallback.
TELEGRAM_WEBHOOK_SECRET="change-me-long-random-string"

# Secret used by Vercel Cron to authenticate cron endpoints.
CRON_SECRET="change-me-another-long-random-string"

# Web Push (PWA notifications) VAPID keys. Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:it@mintechethiopia.com"

# Must exactly equal VAPID_PUBLIC_KEY. This one is exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."

# Single shared password protecting dashboard pages and internal APIs.
ADMIN_PASSWORD="change-me-strong-password"

# Public deployed app URL with no trailing slash.
APP_URL="https://your-project.vercel.app"

# Optional SMS gateway for receivables reminders.
SMS_GATEWAY_URL="https://sms-provider.example/send"
SMS_GATEWAY_TOKEN="..."
SMS_SENDER_ID="MinTech"
