# MinTech Ethiopia System - Environment Variables
# Copy this file to .env.local for local development.
# Add the same variables to Vercel Project Settings -> Environment Variables
# for Production and Preview, then redeploy.

# ── Supabase ──────────────────────────────────────────────────────────────
# Postgres connection string. Use the TRANSACTION POOLER (Supavisor, port 6543)
# from Supabase → Connect → "Transaction pooler". Required for Vercel serverless.
SUPABASE_DB_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Secret API key (sb_secret_...) from Supabase → Project Settings → API keys.
# Server-only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."

# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECTREF.supabase.co"

# Private Storage bucket holding every uploaded photo and receipt. Only set this
# if your bucket is NOT named "mintech-files"; the name must match EXACTLY.
# STORAGE_BUCKET="mintech-files"

# ── AI providers ──────────────────────────────────────────────────────────
# Three providers, each for a different job. All are required.

# Google Gemini (AI Studio → "Get API key"). Reads SALES RECEIPTS: extracts the
# fields AND decides whether an official ink stamp is present, in one call.
# Without this the receipt scanner and the sales-report verification cannot work.
GEMINI_API_KEY="AIza..."

# Optional Gemini overrides. GEMINI_MODEL must be a model your key can call —
# check with:  curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#   https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite
# GEMINI_MODEL="gemini-3.5-flash-lite"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
# Hard timeout for a receipt read, in ms. This runs inside the Telegram webhook,
# which must answer before the serverless function is killed — keep it well
# under the function limit or Telegram will redeliver the update in a loop.
# GEMINI_TIMEOUT_MS="8000"

# NVIDIA API key (note the spelling — the app reads NIVIDA_API_KEY first, then
# NVIDIA_API_KEY). Nemotron: dashboard chat, morning brief, report extraction.
NIVIDA_API_KEY="nvapi-..."
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NEMOTRON_MODEL="nvidia/nemotron-3-ultra-550b-a55b"

# Qwen-VL key. Reads NON-receipt images: damaged-bag claims, stone quality at the
# gate, and general document/photo ingestion.
QWEN_API="sk-..."
# QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# QWEN_MODEL="qwen-vl-max-latest"

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN="123456789:AA..."

# Telegram chat id of the CEO/owner. Used for morning briefs and purchase approvals.
TELEGRAM_CEO_CHAT_ID="123456789"

# The 8:00 AM EAT daily-report reminder is sent to every active employee who is
# signed into the bot. Employees are managed at /settings in the dashboard, so
# no chat ids need to be configured here.

# Random webhook secret. The webhook setup script sends this both as a Telegram
# secret token and as a URL query fallback.
TELEGRAM_WEBHOOK_SECRET="change-me-long-random-string"

# Secret used by Vercel Cron to authenticate cron endpoints.
CRON_SECRET="change-me-another-long-random-string"

# Web Push (PWA notifications) VAPID keys. Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="B..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:it@mintechethiopia.com"

# Must exactly equal VAPID_PUBLIC_KEY. This one is exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="B..."

# Single shared password protecting dashboard pages and internal APIs.
ADMIN_PASSWORD="change-me-strong-password"

# Public deployed app URL with no trailing slash.
APP_URL="https://your-project.vercel.app"

# Optional SMS gateway for receivables reminders.
SMS_GATEWAY_URL="https://sms-provider.example/send"
SMS_GATEWAY_TOKEN="..."
SMS_SENDER_ID="MinTech"
